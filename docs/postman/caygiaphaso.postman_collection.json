{
  "info": {
    "name": "CâyGiaPhảSố API",
    "description": "Complete API collection for CâyGiaPhảSố (AncestryTree) — Spring Boot 3.2.5 backend. Includes all 76 endpoints: auth, users, families, members, recipes (with novel genealogy), stories, time capsules, events, photos, chat, notifications, achievements.\n\nImport this into Postman v9+ along with the matching environment file. Run the `Auth > Login` request first to populate {{accessToken}} for everything else.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "caygiaphaso-collection-2026-09-19",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0
    }
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-attach Authorization header from {{accessToken}} for all authenticated requests",
          "if (pm.variables.has('accessToken') && pm.variables.get('accessToken') !== '' && pm.variables.get('accessToken') !== undefined) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.variables.get('accessToken') });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default smoke test for every request: status and response time",
          "pm.test('Status code is 2xx', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});",
          "pm.test('Response time < 1500ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(1500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Nguyen Van Moi\",\n  \"phone\": \"0912345678\"\n}"
            },
            "description": "Register a new user and receive JWT tokens."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "  pm.collectionVariables.set('userId', body.user.id);",
                  "  pm.test('accessToken is set', function () { pm.expect(body.accessToken).to.exist; });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nguyen-family.vn\",\n  \"password\": \"Password123!\"\n}"
            },
            "description": "Login with a seed account (all use password 'Password123!'). Seed users:\n- admin@nguyen-family.vn (Nguyễn Văn An — owner Họ Nguyễn)\n- lan@nguyen-family.vn (Nguyễn Thị Lan)\n- minh@nguyen-family.vn (Nguyễn Minh)\n- hoa@tran-family.vn (Trần Thị Hoa — owner Họ Trần)\n- tuan@le-family.vn (Lê Văn Tuấn — owner Họ Lê)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "  pm.collectionVariables.set('userId', body.user.id);",
                  "  console.log('Logged in as:', body.user.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Exchange a refresh token for a new access token (and rotate)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Invalidate the current refresh token."
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Returns the currently authenticated user."
          }
        }
      ]
    },
